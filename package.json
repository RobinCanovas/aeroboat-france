{
  "name": "aeroboat-france-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Site Aéroboat France v2 (PHP 8.2 natif, mini-CMS, Vite)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-serve.mjs",
    "build": "vite build",
    "lint:php": "node scripts/lint-php.mjs",
    "test": "php tests/run.php",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "migrate:demo": "php database/migrate.php --demo",
    "release": "node scripts/build-release.mjs",
    "deploy:test": "node scripts/deploy.mjs --env test",
    "push-env": "node scripts/push-env.mjs --env test",
    "ci": "npm run lint:php && npm run test && npm run test:scripts && npm run build && npm run migrate:demo"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/sora": "^5.1.0",
    "basic-ftp": "^6.2.6",
    "vite": "^6.0.0"
  }
}
