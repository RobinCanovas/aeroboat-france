# Copier en .env (local) ou .env.test (poussé par `npm run push-env`). Ne jamais committer de vraies valeurs.

# --- Application ---
APP_ENV=local                      # local | test | production
APP_DEBUG=1                        # 0 en test/production
APP_URL=http://127.0.0.1:8000      # test : https://aeroboat-france.com/test (le chemin sert de préfixe)
APP_KEY=                           # 64 caractères hex aléatoires (openssl rand -hex 32)
SETUP_TOKEN=                       # jeton d'accès à /admin/setup (désactivé dès qu'un compte existe)
SITE_NOINDEX=1                     # 1 = noindex + Disallow: / + bandeau « version de test »
VITE_DEV=0                         # 1 = charge les assets depuis le serveur Vite (npm run dev)

# --- Base de données ---
DB_DRIVER=sqlite                   # sqlite (local) | mysql (OVH)
DB_PATH=database/dev.sqlite        # sqlite uniquement, relatif à la racine du projet
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PREFIX=abf_                     # JAMAIS mod759_ (tables WordPress de production)

# --- Mail (best effort ; la base reste la source de vérité) ---
MAIL_TO=
MAIL_FROM=

# --- Identité de l'association (mentions légales) : champs vides = masqués ---
ORG_NAME=Aéroboat France
ORG_LEGAL_FORM=
ORG_RNA=
ORG_ADDRESS=
ORG_PUBLISHER=
ORG_EMAIL=
ORG_PHONE=
ORG_CITY=Toulouse
ORG_HOST_NAME=OVH SAS
ORG_HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France
